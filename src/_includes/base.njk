<!DOCTYPE html>
<html lang="{{ lang | default('de') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0B0F14">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <!-- Open Graph / Social -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:title" content="{{ ogTitle if ogTitle else (og.title if og else title) }}">
  <meta property="og:description" content="{{ ogDescription if ogDescription else (og.description if og else description) }}">
  <meta property="og:image" content="{{ ogImage if ogImage else (og.image if og else 'https://www.lingener-baumaschinen.de/assets/images/hero/hero-1.jpg') }}">
  <meta property="og:locale" content="{{ ogLocale if ogLocale else (og.locale if og else 'de_DE') }}">
  {% if lang == "en" %}<meta property="og:locale:alternate" content="de_DE">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle if ogTitle else (og.title if og else title) }}">
  <meta name="twitter:description" content="{{ ogDescription if ogDescription else (og.description if og else description) }}">
  <meta name="twitter:image" content="{{ ogImage if ogImage else (og.image if og else 'https://www.lingener-baumaschinen.de/assets/images/hero/hero-1.jpg') }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if langDE and langEN %}
  <link rel="alternate" hreflang="de" href="https://www.lingener-baumaschinen.de{{ langDE }}">
  <link rel="alternate" hreflang="en" href="https://www.lingener-baumaschinen.de{{ langEN }}">
  {% endif %}
  {% if extraHead %}{{ extraHead | safe }}{% endif %}
  {% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}" fetchpriority="high">{% endif %}
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/logo/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/logo/favicon-192.png">
  <link rel="apple-touch-icon" href="/assets/images/logo/apple-touch-icon.png">
  {% if lang == "en" or useGoogleFonts %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/main.css">
  {% else %}
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  {% endif %}
  {% if schema %}
  <script type="application/ld+json">{{ schema | safe }}</script>
  {% endif %}
  {% if lang != "en" %}
  <!-- Google Analytics 4 + Consent Mode v2 — G-XXXXXXXXXX mit echter Measurement-ID ersetzen -->
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',wait_for_update:800});gtag('js',new Date());</script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script>gtag('config','G-XXXXXXXXXX');</script>
  {% else %}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-XXXXXXXXXX');</script>
  {% endif %}
</head>
