<!-- Cookie Consent Banner -->
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-modal="false" aria-label="{% if lang == 'en' %}Cookie Settings{% else %}Cookie-Einstellungen{% endif %}">
  <div class="cookie-banner-inner">
    <div class="cookie-banner-text">
      <strong class="cookie-banner-title">{% if lang == 'en' %}Cookies &amp; Privacy{% else %}Cookies &amp; Datenschutz{% endif %}</strong>
      <p class="cookie-banner-body">{% if lang == 'en' %}We use technically necessary cookies and — with your consent — Google Analytics 4 for anonymised reach measurement. Data may be transferred to the USA. <a href="/en/datenschutz.html">Privacy Policy</a>{% else %}Wir nutzen technisch notwendige Cookies sowie – mit Ihrer Zustimmung – Google Analytics 4 zur anonymisierten Reichweitenmessung. Dabei können Daten in die USA übermittelt werden. <a href="/datenschutz.html">Datenschutzerklärung</a>{% endif %}</p>
    </div>
    <div class="cookie-banner-actions">
      <button class="cookie-btn cookie-btn-decline" id="cookie-decline" type="button">{% if lang == 'en' %}Decline{% else %}Ablehnen{% endif %}</button>
      <button class="cookie-btn cookie-btn-accept" id="cookie-accept" type="button">{% if lang == 'en' %}Accept{% else %}Akzeptieren{% endif %}</button>
    </div>
  </div>
</div>
<button type="button" class="scroll-top" id="scroll-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="{% if lang == 'en' %}Back to top{% else %}Nach oben{% endif %}">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
</button>
<script src="/assets/js/main.js" defer></script>

</body>
