      <div>© <span data-year></span> Lingener Baumaschinen GmbH &amp; Co. KG</div>
      <div class="footer-bottom-links">
        <a href="/impressum.html">Impressum</a>
        <a href="/datenschutz.html">Datenschutz</a>
        <a href="/agb.html">AGB</a>
        <button class="footer-consent-btn" data-reset-consent type="button">Cookie-Einstellungen</button>
      </div>
    </div>
  </div>
</footer>

{% endif %}

<!-- Floating Contact Button -->
