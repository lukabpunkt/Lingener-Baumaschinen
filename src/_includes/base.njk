        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </span>
      <span>{% if lang == "en" %}Directions{% else %}Anfahrt{% endif %}</span>
    </a>
  </div>
  <button class="fab-btn" id="fab-btn" aria-expanded="false" aria-haspopup="true" aria-label="{% if lang == 'en' %}Open contact options{% else %}Kontaktoptionen öffnen{% endif %}">
    <svg class="fab-btn-icon fab-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <svg class="fab-btn-icon fab-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    <span class="fab-label">{% if lang == "en" %}Contact{% else %}Kontakt{% endif %}</span>
