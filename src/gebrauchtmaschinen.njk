<section class="page-hero">
  <div class="page-hero-bg" style="background-image: url('/assets/images/products/gm-4-raupe.jpg');" aria-hidden="true"></div>
  <div class="container">
    <div class="breadcrumbs"><a href="{% if lang == 'de' %}/index.html{% else %}/en/index.html{% endif %}">{% if lang == "de" %}Start{% else %}Home{% endif %}</a><span class="sep">/</span><a href="{% if lang == 'de' %}/maschinen.html{% else %}/en/maschinen.html{% endif %}">{% if lang == "de" %}Maschinen{% else %}Machines{% endif %}</a><span class="sep">/</span><span>{% if lang == "de" %}Gebrauchtmaschinen{% else %}Used Machines{% endif %}</span></div>
    <span class="eyebrow hero-eyebrow"><span class="dot"></span>{% if lang == "de" %}Direkt vom Hersteller{% else %}Direct from the manufacturer{% endif %}</span>
    <h1 data-split-lines class="mt-3">{% if lang == "de" %}Gebraucht.<br><em class="serif-italic">Nicht kompromittiert.</em>{% else %}Used.<br><em class="serif-italic">Not compromised.</em>{% endif %}</h1>
    <p>{% if lang == "de" %}Jede LIBA-Gebrauchtmaschine durchläuft eine vollständige Werksinspektion, bevor sie das Haus verlässt. Was wir nicht mit gutem Gewissen verkaufen können, verkaufen wir nicht.{% else %}Every LIBA used machine undergoes a full factory inspection before it leaves our premises. What we cannot sell in good conscience, we do not sell.{% endif %}</p>
    <div class="hero-actions mt-4">
      <a href="#anfrage" class="btn btn-accent is-lg">{% if lang == "de" %}Verfügbarkeit anfragen{% else %}Check availability{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      <a href="{% if lang == 'de' %}/maschinen.html{% else %}/en/maschinen.html{% endif %}" class="btn btn-outline-light">{% if lang == "de" %}Neue Maschinen{% else %}New machines{% endif %}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="split align-start reveal">
      <div>
        <span class="section-index">{% if lang == "de" %}01 / Unser Versprechen{% else %}01 / Our Promise{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Kein Händler.<br>Kein Risiko.<br><em class="serif-italic">Werksstandard.</em>{% else %}No dealers.<br>No risk.<br><em class="serif-italic">Factory standard.</em>{% endif %}</h2>
        <p class="lead mt-3">{% if lang == "de" %}Gebrauchte LIBA-Maschinen kommen direkt aus unserem Werk — nicht aus Auktionen, nicht von Zwischenhändlern. Wir kennen jede Maschine, die wir gebaut haben.{% else %}Used LIBA machines come directly from our factory — not from auctions, not from middlemen. We know every machine we have built.{% endif %}</p>
        <ul class="spec-list is-kerf">
          <li><strong>{% if lang == "de" %}Vollständige Werksinspektion{% else %}Full factory inspection{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Hydraulik, Fräswelle, Kette, Lager, Elektrik — alles geprüft, defekte Teile ersetzt.{% else %}Hydraulics, cutter shaft, chain, bearings, electrics — all checked, defective parts replaced.{% endif %}</span></li>
          <li><strong>{% if lang == "de" %}Lückenlose Maschinenhistorie{% else %}Complete machine history{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Wir wissen, wo jede Maschine war und was sie geleistet hat.{% else %}We know where every machine has been and what it has done.{% endif %}</span></li>
          <li><strong>{% if lang == "de" %}Werksgarantie auf Instandsetzung{% else %}Factory warranty on reconditioning{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Alle im Rahmen der Inspektion getauschten Teile sind garantiert.{% else %}All parts replaced during inspection are warranted.{% endif %}</span></li>
          <li><strong>{% if lang == "de" %}Einweisung inklusive{% else %}Operator training included{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Übergabe mit Bedienereinweisung durch unser Werkspersonal.{% else %}Handover with operator training by our factory personnel.{% endif %}</span></li>
        </ul>
      </div>
      <div class="media-frame is-wide">
        <picture><source type="image/webp" srcset="/assets/images/products/gm-180-af.webp"><img loading="lazy" src="/assets/images/products/gm-180-af.jpg" alt="{% if lang == 'de' %}LIBA Gebrauchtmaschine nach Werksinspektion{% else %}LIBA used machine after factory inspection{% endif %}" width="1024" height="576"></picture>
        <span class="tag">{% if lang == "de" %}Werksinspektion · Lingen (Ems){% else %}Factory inspection · Lingen (Ems){% endif %}</span>
      </div>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index is-dark" style="color: var(--brand-light);">{% if lang == "de" %}02 / Verfügbare Modelle{% else %}02 / Available Models{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Aktuelle<br><em class="serif-italic">Gebrauchtmaschinen.</em>{% else %}Current<br><em class="serif-italic">used machines.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Verfügbarkeit und Konditionen auf Anfrage. Bestand wechselt — sprechen Sie uns an, bevor Sie suchen.{% else %}Availability and pricing on request. Stock changes — contact us before you search elsewhere.{% endif %}</p>
      </div>
    </div>

    <div class="grid grid-3">
      <article class="news-card reveal">
        <div class="news-card-image"><picture><source type="image/webp" srcset="/assets/images/products/gm-4-raupe.webp"><img loading="lazy" src="/assets/images/products/gm-4-raupe.jpg" alt="{% if lang == 'de' %}GM 4 Raupe Gebraucht{% else %}GM 4 Crawler used{% endif %}" width="1024" height="768"></picture></div>
        <div class="news-card-body">
          <div class="news-card-meta">{% if lang == "de" %}Selbstfahrer · Glasfaser{% else %}Self-propelled · Fibre Optic{% endif %}</div>
          <h3>{% if lang == "de" %}GM 4 Raupe{% else %}GM 4 Crawler{% endif %}</h3>
          <p>{% if lang == "de" %}Typ: Raupen-Selbstfahrer. Einsatz: Glasfaser / FTTH. Status: <strong style="color: var(--brand);">auf Anfrage</strong>{% else %}Type: Crawler self-propelled. Application: Fibre optic / FTTH. Status: <strong style="color: var(--brand);">on request</strong>{% endif %}</p>
          <a href="#anfrage" class="link mt-3">{% if lang == "de" %}Verfügbarkeit erfragen{% else %}Check availability{% endif %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>
      <article class="news-card reveal reveal-delay-1">
        <div class="news-card-image"><picture><source type="image/webp" srcset="/assets/images/products/gm-180-af.webp"><img loading="lazy" src="/assets/images/products/gm-180-af.jpg" alt="{% if lang == 'de' %}GM 180 AF Gebraucht{% else %}GM 180 AF used{% endif %}" width="1024" height="576"></picture></div>
        <div class="news-card-body">
          <div class="news-card-meta">{% if lang == "de" %}Schlepperanbau · Flaggschiff{% else %}Tractor-mounted · Flagship{% endif %}</div>
          <h3>GM 180 AF</h3>
          <p>{% if lang == "de" %}Typ: Schlepperanbau. Einsatz: Pipeline / Kabel / Glasfaser. Status: <strong style="color: var(--brand);">auf Anfrage</strong>{% else %}Type: Tractor-mounted. Application: Pipeline / Cable / Fibre optic. Status: <strong style="color: var(--brand);">on request</strong>{% endif %}</p>
          <a href="#anfrage" class="link mt-3">{% if lang == "de" %}Verfügbarkeit erfragen{% else %}Check availability{% endif %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>
      <article class="news-card reveal reveal-delay-2">
        <div class="news-card-image"><picture><source type="image/webp" srcset="/assets/images/products/gm-6-asr.webp"><img loading="lazy" src="/assets/images/products/gm-6-asr.jpg" alt="{% if lang == 'de' %}GM 6 ASR Gebraucht{% else %}GM 6 ASR used{% endif %}" width="1024" height="768"></picture></div>
        <div class="news-card-body">
          <div class="news-card-meta">{% if lang == "de" %}Selbstfahrer · Felsen{% else %}Self-propelled · Rock{% endif %}</div>
          <h3>GM 6 ASR</h3>
          <p>{% if lang == "de" %}Typ: Felsfräse Selbstfahrer. Einsatz: Bergbau / Fels. Status: <strong style="color: var(--brand);">auf Anfrage</strong>{% else %}Type: Rock cutter self-propelled. Application: Mining / Rock. Status: <strong style="color: var(--brand);">on request</strong>{% endif %}</p>
          <a href="#anfrage" class="link mt-3">{% if lang == "de" %}Verfügbarkeit erfragen{% else %}Check availability{% endif %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="section section-dark" id="anfrage" style="padding-top: 0;">
  <div class="container" style="padding-top: var(--section-y);">
    <div class="split align-start" style="gap: 4rem;">
      <div class="reveal">
        <span class="section-index is-dark" style="color: var(--brand-light);">{% if lang == "de" %}03 / Anfrage{% else %}03 / Enquiry{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Welche Maschine<br>suchen <em>Sie?</em>{% else %}Which machine<br>are you <em>looking for?</em>{% endif %}</h2>
        <p class="lead mt-3">{% if lang == "de" %}Teilen Sie uns Einsatzprofil, Bodenart und Budget mit — wir prüfen, ob wir etwas Passendes haben, und informieren Sie auch über neue Zugänge.{% else %}Share your application profile, ground type and budget with us — we'll check whether we have something suitable and keep you informed about new arrivals.{% endif %}</p>
        <ul class="spec-list is-kerf">
          <li><strong>{% if lang == "de" %}Direkt vom Werk{% else %}Direct from the factory{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Kein Aufschlag durch Zwischenhändler.{% else %}No premium through middlemen.{% endif %}</span></li>
          <li><strong>{% if lang == "de" %}Schnelle Antwort{% else %}Fast response{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Rückmeldung innerhalb eines Werktags.{% else %}Reply within one working day.{% endif %}</span></li>
        </ul>
      </div>
      <form class="form reveal reveal-delay-1" data-form="https://formspree.io/f/YOUR_FORMSPREE_ID_GEBRAUCHT" action="https://formspree.io/f/YOUR_FORMSPREE_ID_GEBRAUCHT" method="POST">
        <div class="form-row">
          <div class="field"><label for="g-name">{% if lang == "de" %}Name{% else %}Name{% endif %}</label><input id="g-name" name="name" required></div>
          <div class="field"><label for="g-firma">{% if lang == "de" %}Firma{% else %}Company{% endif %}</label><input id="g-firma" name="firma"></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="g-email">{% if lang == "de" %}E-Mail{% else %}Email{% endif %}</label><input id="g-email" type="email" name="email" required></div>
          <div class="field"><label for="g-tel">{% if lang == "de" %}Telefon{% else %}Phone{% endif %}</label><input id="g-tel" type="tel" name="tel"></div>
        </div>
        <div class="field">
          <label for="g-modell">{% if lang == "de" %}Gesuchtes Modell{% else %}Model sought{% endif %}</label>
          <select id="g-modell" name="modell">
            {% if lang == "de" %}
            <option>Beratung gewünscht</option>
            <option>GM 4 Raupe</option>
            <option>GM 4 Allrad</option>
            <option>GM 6 ASR</option>
            <option>GM 180 AF</option>
            <option>GM 140 AFH</option>
            <option>Sonstiges Modell</option>
            {% else %}
            <option>Advice requested</option>
            <option>GM 4 Crawler</option>
            <option>GM 4 All-Wheel</option>
            <option>GM 6 ASR</option>
            <option>GM 180 AF</option>
            <option>GM 140 AFH</option>
            <option>Other model</option>
            {% endif %}
          </select>
        </div>
        <div class="field"><label for="g-details">{% if lang == "de" %}Einsatzprofil &amp; Budget{% else %}Application profile &amp; budget{% endif %}</label><textarea id="g-details" name="details" placeholder="{% if lang == 'de' %}Bodenart, Grabentiefe, Einsatzgebiet, Preisvorstellung{% else %}Ground type, trench depth, area of application, budget{% endif %}"></textarea></div>
        <label class="field-check"><input type="checkbox" required> {% if lang == "de" %}Ich habe die <a href="/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Datenschutzerklärung</a> zur Kenntnis genommen.{% else %}I have read the <a href="/en/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Privacy Policy</a>.{% endif %}</label>
        <button type="submit" class="btn btn-brand is-lg" style="justify-self: start;">{% if lang == "de" %}Anfrage senden{% else %}Send enquiry{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button>
        <p data-form-status role="status" hidden style="color: var(--brand); font-weight: 500;"></p>
      </form>
    </div>
  </div>
</section>
