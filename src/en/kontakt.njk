<section class="section section-dark" id="anfrage" style="padding-top: 0;">
  <div class="container" style="padding-top: var(--section-y);">
    <div class="split align-start" style="gap: 4rem;">
      <div class="reveal">
        <span class="section-index is-dark" style="color: var(--brand-light);">01 / Enquiry</span>
        <h2 class="mt-3">Tell us what<br>you're <em>planning.</em></h2>
        <p class="lead mt-3">Whether it's a specific project, general advice or a spare part search — we respond promptly and talk directly about your application.</p>
        <ul class="spec-list">
          <li><span class="num">01</span><div><strong>Technical advice</strong><span>Direct from the LIBA design engineers.</span></div></li>
          <li><span class="num">02</span><div><strong>24h response</strong><span>On working days, within one business day.</span></div></li>
          <li><span class="num">03</span><div><strong>Personal point of contact</strong><span>From first enquiry through to delivery.</span></div></li>
        </ul>
      </div>
      <form class="form reveal reveal-delay-1" data-form="https://formspree.io/f/YOUR_FORMSPREE_ID" action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST">
        <div class="form-row">
          <div class="field"><label for="k-name">Name</label><input id="k-name" name="name" required></div>
          <div class="field"><label for="k-firma">Company</label><input id="k-firma" name="firma"></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="k-email">Email</label><input id="k-email" type="email" name="email" required></div>
          <div class="field"><label for="k-tel">Phone</label><input id="k-tel" type="tel" name="tel"></div>
        </div>
        <div class="field">
          <label for="k-betreff">Subject</label>
          <select id="k-betreff" name="betreff">
            <option>Purchase enquiry</option>
            <option>Hire enquiry</option>
            <option>Spare parts</option>
            <option>Used machines</option>
            <option>Training</option>
            <option>General enquiry</option>
          </select>
        </div>
        <div class="field"><label for="k-nachricht">Message</label><textarea id="k-nachricht" name="nachricht" placeholder="Please describe your requirements, project or the part you are looking for." required></textarea></div>
        <label class="field-check"><input type="checkbox" required> I have read the <a href="/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Privacy Policy</a>.</label>
        <button type="submit" class="btn btn-brand is-lg" style="justify-self: start;">Send enquiry <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button>
        <p data-form-status role="status" hidden style="color: var(--brand); font-weight: 500;"></p>
      </form>
    </div>
  </div>
</section>
