<section class="page-hero">
  <div class="page-hero-bg" style="background-image: url('/assets/images/hero/hero-2-bg.webp');" aria-hidden="true"></div>
  <div class="container">
    <div class="breadcrumbs"><a href="{% if lang == 'de' %}/index.html{% else %}/en/index.html{% endif %}">{% if lang == "de" %}Start{% else %}Home{% endif %}</a><span class="sep">/</span><span>{% if lang == "de" %}Kontakt{% else %}Contact{% endif %}</span></div>
    <span class="eyebrow hero-eyebrow"><span class="dot"></span>{% if lang == "de" %}Direkt vom Werk{% else %}Direct from the factory{% endif %}</span>
    <h1 data-split-lines class="mt-3">{% if lang == "de" %}Kein Anrufcenter.<br><em class="serif-italic">Kein Zwischenhändler.</em>{% else %}No call centre.<br><em class="serif-italic">No middlemen.</em>{% endif %}</h1>
    <p>{% if lang == "de" %}Sprechen Sie direkt mit dem LIBA-Team in Lingen. Wir antworten schnell, technisch fundiert und auf Augenhöhe — egal ob Kauf, Miete, Ersatzteil oder Schulung.{% else %}Speak directly with the LIBA team in Lingen. We respond quickly, with genuine technical expertise and straight talk — whether it's a purchase, hire, spare part or training.{% endif %}</p>
  </div>
</section>

<section class="section section-dark" id="anfrage">
  <div class="container">
    <div class="section-header reveal" style="margin-bottom: 2.5rem;">
      <div class="heading">
        <span class="section-index is-dark" style="color: var(--brand-light);">{% if lang == "de" %}01 / Termin{% else %}01 / Book a call{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Termin für ein<br><em class="serif-italic">Beratungsgespräch.</em>{% else %}Book a<br><em class="serif-italic">consultation call.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Wählen Sie einen freien Termin — wir rufen Sie zur vereinbarten Zeit direkt an. Kein Callcenter, keine Warteschleife.{% else %}Pick a free slot and we'll call you at the agreed time. No call centre, no hold music.{% endif %}</p>
        <ul class="spec-list is-kerf mt-3">
          <li><strong>{% if lang == "de" %}30 Minuten{% else %}30 minutes{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Technische Beratung direkt vom LIBA-Konstrukteur.{% else %}Technical advice direct from the LIBA engineering team.{% endif %}</span></li>
          <li><strong>{% if lang == "de" %}Direkte Leitung{% else %}Direct line{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Persönlicher Ansprechpartner vom Erstkontakt bis zur Auslieferung.{% else %}Personal point of contact from first enquiry through to delivery.{% endif %}</span></li>
        </ul>
      </div>
    </div>
    <div class="reveal">
      <!-- Calendly erst nach ausdrücklicher Einwilligung laden (DSGVO: kein US-Transfer vor Klick) -->
      <div id="calendly-consent" style="border:1px solid var(--line,#d8d8d8); border-radius:12px; padding:1.75rem; text-align:center; background:var(--surface,#f6f5f2); color:var(--ink,#1a2230);">
        <p style="margin:0 0 1rem; color:#1a2230;">{% if lang == 'de' %}Online-Terminbuchung über <strong>Calendly</strong>. Beim Laden werden Daten (u. a. Ihre IP-Adresse) an Calendly LLC in den USA übertragen.{% else %}Online appointment booking via <strong>Calendly</strong>. Loading it transfers data (incl. your IP address) to Calendly LLC in the USA.{% endif %}</p>
        <button type="button" class="btn btn-primary" id="calendly-load">{% if lang == 'de' %}Terminbuchung laden{% else %}Load booking calendar{% endif %}</button>
      </div>
      <div class="calendly-inline-widget"
        data-calendly-url="https://calendly.com/luka-bloemendal/30min?background_color=111827&text_color=f1f5f9&primary_color=5eead4{% if lang == 'de' %}&locale=de{% else %}&locale=en{% endif %}"
        style="min-width: 320px; display:none;"></div>
      <!-- Klick-zum-Laden-Logik liegt in /assets/js/main.js (CSP ohne 'unsafe-inline') -->
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-2 reveal">
      <a href="tel:+4959176314" class="contact-card is-phone">
        <div class="contact-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}Telefon · Mo – Fr · 08–16 Uhr{% else %}Telephone · Mon – Fri · 08:00–16:00{% endif %}</div>
        <h3>+49 (0) 591 76 314</h3>
      </a>
      <a href="{% if lang == 'de' %}https://wa.me/4959176314?text=Hallo%20LIBA%2C%20ich%20m%C3%B6chte%20eine%20Anfrage%20stellen.{% else %}https://wa.me/4959176314?text=Hello%20LIBA%2C%20I%20would%20like%20to%20make%20an%20enquiry.{% endif %}" class="contact-card" target="_blank" rel="noopener noreferrer">
        <div class="contact-card-icon is-whatsapp">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.534 4.056 1.475 5.768L.057 23.928l6.304-1.395A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.808 9.808 0 01-4.999-1.363l-.36-.212-3.72.822.842-3.635-.235-.374A9.806 9.806 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182c5.43 0 9.818 4.388 9.818 9.818 0 5.43-4.388 9.818-9.818 9.818z"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}WhatsApp · schnelle Antwort{% else %}WhatsApp · quick response{% endif %}</div>
        <h3>{% if lang == "de" %}Direkt schreiben{% else %}Message us directly{% endif %}</h3>
      </a>
      <a href="mailto:info@lingener-baumaschinen.de" class="contact-card">
        <div class="contact-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}E-Mail · Antwort &lt; 24 h{% else %}Email · reply &lt; 24 h{% endif %}</div>
        <h3>info@lingener-baumaschinen.de</h3>
      </a>
      <a href="https://maps.google.com/?q=Diekstrasse+59,+49809+Lingen+(Ems)" target="_blank" rel="noopener noreferrer" class="contact-card">
        <div class="contact-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}Werk &amp; Anschrift{% else %}Factory &amp; Address{% endif %}</div>
        <h3>Diekstrasse 59<br>49809 Lingen (Ems)</h3>
      </a>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0; padding-bottom: 0;">
  <div class="container">
    <div class="opening-hours reveal">
      <h3 class="opening-hours-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {% if lang == "de" %}Öffnungszeiten{% else %}Opening hours{% endif %}
      </h3>
      <dl class="opening-hours-grid">
        <dt>{% if lang == "de" %}Montag{% else %}Monday{% endif %}</dt>    <dd>08:00–16:00</dd>
        <dt>{% if lang == "de" %}Dienstag{% else %}Tuesday{% endif %}</dt>  <dd>08:00–16:00</dd>
        <dt>{% if lang == "de" %}Mittwoch{% else %}Wednesday{% endif %}</dt><dd>08:00–16:00</dd>
        <dt>{% if lang == "de" %}Donnerstag{% else %}Thursday{% endif %}</dt><dd>08:00–16:00</dd>
        <dt>{% if lang == "de" %}Freitag{% else %}Friday{% endif %}</dt>    <dd>08:00–16:00</dd>
        <dt class="is-closed">{% if lang == "de" %}Samstag{% else %}Saturday{% endif %}</dt><dd class="is-closed">{% if lang == "de" %}Geschlossen{% else %}Closed{% endif %}</dd>
        <dt class="is-closed">{% if lang == "de" %}Sonntag{% else %}Sunday{% endif %}</dt>  <dd class="is-closed">{% if lang == "de" %}Geschlossen{% else %}Closed{% endif %}</dd>
      </dl>
    </div>
  </div>
</section>

<section class="section" id="kontaktformular" style="padding-top: 0;">
  <div class="container">
    <hr class="divider">
    <div class="split align-start reveal">
      <div>
        <span class="section-index">{% if lang == "de" %}02 / Schreiben Sie uns{% else %}02 / Send us a message{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Lieber per<br><em class="serif-italic">Formular?</em>{% else %}Prefer to<br><em class="serif-italic">write to us?</em>{% endif %}</h2>
        <p class="lead mt-3">{% if lang == "de" %}Beschreiben Sie kurz Ihr Anliegen — wir antworten werktags innerhalb von 24 Stunden.{% else %}Briefly describe your enquiry — we respond on working days within 24 hours.{% endif %}</p>
        <ul class="spec-list is-kerf mt-4">
          <li><strong>{% if lang == "de" %}Antwort in 24 h{% else %}Reply within 24 h{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Werktags, direkt aus dem Werk Lingen.{% else %}On working days, direct from the Lingen factory.{% endif %}</span></li>
          <li><strong>{% if lang == "de" %}Kein Callcenter{% else %}No call centre{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Ihr Anliegen geht direkt an das LIBA-Vertriebsteam.{% else %}Your message goes directly to the LIBA sales team.{% endif %}</span></li>
        </ul>
      </div>
      <form class="form reveal reveal-delay-1" name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-form="kontakt"
            data-success="{% if lang == 'de' %}Vielen Dank — Ihre Anfrage ist eingegangen. Wir melden uns innerhalb von 24 Stunden.{% else %}Thank you — your enquiry has been received. We will get back to you within 24 hours.{% endif %}"
            data-sending="{% if lang == 'de' %}Wird gesendet …{% else %}Sending …{% endif %}"
            data-error="{% if lang == 'de' %}Senden fehlgeschlagen. Bitte rufen Sie uns an oder schreiben Sie eine E-Mail.{% else %}Sending failed. Please call us or send an email.{% endif %}">
        <input type="hidden" name="form-name" value="kontakt">
        <p hidden><label>{% if lang == 'de' %}Nicht ausfüllen{% else %}Do not fill this in{% endif %}: <input name="bot-field"></label></p>
        <div class="form-row">
          <div class="field"><label for="k-name">{% if lang == "de" %}Name *{% else %}Name *{% endif %}</label><input id="k-name" name="name" required></div>
          <div class="field"><label for="k-firma">{% if lang == "de" %}Firma{% else %}Company{% endif %}</label><input id="k-firma" name="firma"></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="k-email">{% if lang == "de" %}E-Mail *{% else %}Email *{% endif %}</label><input id="k-email" type="email" name="email" required></div>
          <div class="field"><label for="k-tel">{% if lang == "de" %}Telefon{% else %}Phone{% endif %}</label><input id="k-tel" type="tel" name="tel"></div>
        </div>
        <div class="field"><label for="k-betreff">{% if lang == "de" %}Betreff{% else %}Subject{% endif %}</label>
          <select id="k-betreff" name="betreff">
            <option value="">{% if lang == "de" %}Bitte wählen…{% else %}Please select…{% endif %}</option>
            <option value="Kauf">{% if lang == "de" %}Maschinenkauf{% else %}Machine purchase{% endif %}</option>
            <option value="Miete">{% if lang == "de" %}Maschinenmiete{% else %}Machine hire{% endif %}</option>
            <option value="Gebraucht">{% if lang == "de" %}Gebrauchtmaschine{% else %}Used machine{% endif %}</option>
            <option value="Service">{% if lang == "de" %}Service / Ersatzteile{% else %}Service / spare parts{% endif %}</option>
            <option value="Sonstiges">{% if lang == "de" %}Sonstiges{% else %}Other{% endif %}</option>
          </select>
        </div>
        <div class="field"><label for="k-nachricht">{% if lang == "de" %}Nachricht *{% else %}Message *{% endif %}</label><textarea id="k-nachricht" name="nachricht" placeholder="{% if lang == 'de' %}Wie können wir Ihnen helfen?{% else %}How can we help you?{% endif %}" required></textarea></div>
        <label class="field-check"><input type="checkbox" name="datenschutz" value="akzeptiert" required> {% if lang == "de" %}Ich habe die <a href="/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Datenschutzerklärung</a> zur Kenntnis genommen.{% else %}I have read the <a href="/en/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Privacy Policy</a>.{% endif %}</label>
        <button type="submit" class="btn btn-primary mt-4">{% if lang == "de" %}Nachricht senden{% else %}Send message{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button>
        <p data-form-status role="status" hidden style="color: var(--brand); font-weight: 500;"></p>
      </form>
    </div>
  </div>
</section>
