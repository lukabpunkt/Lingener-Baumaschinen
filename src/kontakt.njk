<section class="page-hero">
  <div class="page-hero-bg" style="background-image: url('/assets/images/hero/hero-2.jpg');" aria-hidden="true"></div>
  <div class="container">
    <div class="breadcrumbs"><a href="{% if lang == 'de' %}/index.html{% else %}/en/index.html{% endif %}">{% if lang == "de" %}Start{% else %}Home{% endif %}</a><span class="sep">/</span><span>{% if lang == "de" %}Kontakt{% else %}Contact{% endif %}</span></div>
    <span class="eyebrow hero-eyebrow"><span class="dot"></span>{% if lang == "de" %}Direkt vom Werk{% else %}Direct from the factory{% endif %}</span>
    <h1 data-split-lines class="mt-3">{% if lang == "de" %}Kein Anrufcenter.<br><em class="serif-italic">Kein Zwischenhändler.</em>{% else %}No call centre.<br><em class="serif-italic">No middlemen.</em>{% endif %}</h1>
    <p>{% if lang == "de" %}Sprechen Sie direkt mit dem LIBA-Team in Lingen. Wir antworten schnell, technisch fundiert und auf Augenhöhe — egal ob Kauf, Miete, Ersatzteil oder Schulung.{% else %}Speak directly with the LIBA team in Lingen. We respond quickly, with genuine technical expertise and on equal terms — whether it's a purchase, hire, spare part or training.{% endif %}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-2 reveal">
      <a href="tel:+4959176314" class="contact-card is-phone">
        <div class="contact-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}Telefon · Mo – Fr · 08–17 Uhr{% else %}Telephone · Mon – Fri · 08:00–17:00{% endif %}</div>
        <h3>+49 (0) 591 76 314</h3>
      </a>
      <a href="{% if lang == 'de' %}https://wa.me/4959176314?text=Hallo%20LIBA%2C%20ich%20m%C3%B6chte%20eine%20Anfrage%20stellen.{% else %}https://wa.me/4959176314?text=Hello%20LIBA%2C%20I%20would%20like%20to%20make%20an%20enquiry.{% endif %}" class="contact-card" target="_blank" rel="noopener noreferrer">
        <div class="contact-card-icon is-whatsapp">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.534 4.056 1.475 5.768L.057 23.928l6.304-1.395A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.808 9.808 0 01-4.999-1.363l-.36-.212-3.72.822.842-3.635-.235-.374A9.806 9.806 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182c5.43 0 9.818 4.388 9.818 9.818 0 5.43-4.388 9.818-9.818 9.818z"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}WhatsApp · schnelle Antwort{% else %}WhatsApp · quick response{% endif %}</div>
        <h3>{% if lang == "de" %}Direkt schreiben{% else %}Message us directly{% endif %}</h3>
      </a>
      <a href="mailto:info@lingener-baumaschinen.de" class="contact-card">
        <div class="contact-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}E-Mail · Antwort &lt; 24 h{% else %}Email · reply &lt; 24 h{% endif %}</div>
        <h3>info@lingener-baumaschinen.de</h3>
      </a>
      <a href="https://maps.google.com/?q=Diekstrasse+59,+49809+Lingen+(Ems)" target="_blank" rel="noopener noreferrer" class="contact-card">
        <div class="contact-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="contact-card-label">{% if lang == "de" %}Werk &amp; Anschrift{% else %}Factory &amp; Address{% endif %}</div>
        <h3>Diekstrasse 59<br>49809 Lingen (Ems)</h3>
      </a>
    </div>
  </div>
</section>

<section class="section section-dark" id="anfrage" style="padding-top: 0;">
  <div class="container" style="padding-top: var(--section-y);">
    <div class="split align-start" style="gap: 4rem;">
      <div class="reveal">
        <span class="section-index is-dark" style="color: var(--brand-light);">{% if lang == "de" %}01 / Anfrage{% else %}01 / Enquiry{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Sagen Sie uns,<br>was Sie <em>planen.</em>{% else %}Tell us what<br>you're <em>planning.</em>{% endif %}</h2>
        <p class="lead mt-3">{% if lang == "de" %}Egal ob konkretes Projekt, allgemeine Beratung oder Ersatzteil-Suche — wir melden uns zeitnah und sprechen direkt über Ihren Anwendungsfall.{% else %}Whether it's a specific project, general advice or a spare part search — we respond promptly and talk directly about your application.{% endif %}</p>
        <ul class="spec-list">
          <li><span class="num">01</span><div><strong>{% if lang == "de" %}Technische Beratung{% else %}Technical advice{% endif %}</strong><span>{% if lang == "de" %}Direkt vom LIBA-Konstrukteur.{% else %}Direct from the LIBA design engineers.{% endif %}</span></div></li>
          <li><span class="num">02</span><div><strong>{% if lang == "de" %}24h-Rückmeldung{% else %}24h response{% endif %}</strong><span>{% if lang == "de" %}Werktags innerhalb eines Arbeitstages.{% else %}On working days, within one business day.{% endif %}</span></div></li>
          <li><span class="num">03</span><div><strong>{% if lang == "de" %}Persönlicher Ansprechpartner{% else %}Personal point of contact{% endif %}</strong><span>{% if lang == "de" %}Vom Erstkontakt bis zur Auslieferung.{% else %}From first enquiry through to delivery.{% endif %}</span></div></li>
        </ul>
      </div>
      <form class="form reveal reveal-delay-1" data-form="https://formspree.io/f/YOUR_FORMSPREE_ID" action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST">
        <div class="form-row">
          <div class="field"><label for="k-name">Name</label><input id="k-name" name="name" required></div>
          <div class="field"><label for="k-firma">{% if lang == "de" %}Firma{% else %}Company{% endif %}</label><input id="k-firma" name="firma"></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="k-email">{% if lang == "de" %}E-Mail{% else %}Email{% endif %}</label><input id="k-email" type="email" name="email" required></div>
          <div class="field"><label for="k-tel">{% if lang == "de" %}Telefon{% else %}Phone{% endif %}</label><input id="k-tel" type="tel" name="tel"></div>
        </div>
        <div class="field">
          <label for="k-betreff">{% if lang == "de" %}Betreff{% else %}Subject{% endif %}</label>
          <select id="k-betreff" name="betreff">
            <option>{% if lang == "de" %}Kaufanfrage{% else %}Purchase enquiry{% endif %}</option>
            <option>{% if lang == "de" %}Mietanfrage{% else %}Hire enquiry{% endif %}</option>
            <option>{% if lang == "de" %}Ersatzteile{% else %}Spare parts{% endif %}</option>
            <option>{% if lang == "de" %}Gebrauchtmaschinen{% else %}Used machines{% endif %}</option>
            <option>{% if lang == "de" %}Schulung{% else %}Training{% endif %}</option>
            <option>{% if lang == "de" %}Allgemeine Anfrage{% else %}General enquiry{% endif %}</option>
          </select>
        </div>
        <div class="field"><label for="k-nachricht">{% if lang == "de" %}Nachricht{% else %}Message{% endif %}</label><textarea id="k-nachricht" name="nachricht" placeholder="{% if lang == 'de' %}Bitte beschreiben Sie Ihr Anliegen, Projekt oder gesuchtes Bauteil.{% else %}Please describe your requirements, project or the part you are looking for.{% endif %}" required></textarea></div>
        <label class="field-check"><input type="checkbox" required> {% if lang == "de" %}Ich habe die <a href="/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Datenschutzerklärung</a> zur Kenntnis genommen.{% else %}I have read the <a href="/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Privacy Policy</a>.{% endif %}</label>
        <button type="submit" class="btn btn-brand is-lg" style="justify-self: start;">{% if lang == "de" %}Anfrage senden{% else %}Send enquiry{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button>
        <p data-form-status role="status" hidden style="color: var(--brand); font-weight: 500;"></p>
      </form>
    </div>
  </div>
</section>
