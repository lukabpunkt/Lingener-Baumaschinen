<section class="section section-dark" id="anfrage" style="padding-top: 0;">
  <div class="container" style="padding-top: var(--section-y);">
    <div class="split align-start" style="gap: 4rem;">
      <div class="reveal">
        <span class="section-index is-dark" style="color: var(--brand-light);">01 / Anfrage</span>
        <h2 class="mt-3">Sagen Sie uns,<br>was Sie <em>planen.</em></h2>
        <p class="lead mt-3">Egal ob konkretes Projekt, allgemeine Beratung oder Ersatzteil-Suche — wir melden uns zeitnah und sprechen direkt über Ihren Anwendungsfall.</p>
        <ul class="spec-list">
          <li><span class="num">01</span><div><strong>Technische Beratung</strong><span>Direkt vom LIBA-Konstrukteur.</span></div></li>
          <li><span class="num">02</span><div><strong>24h-Rückmeldung</strong><span>Werktags innerhalb eines Arbeitstages.</span></div></li>
          <li><span class="num">03</span><div><strong>Persönlicher Ansprechpartner</strong><span>Vom Erstkontakt bis zur Auslieferung.</span></div></li>
        </ul>
      </div>
      <form class="form reveal reveal-delay-1" data-form="https://formspree.io/f/YOUR_FORMSPREE_ID" action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST">
        <div class="form-row">
          <div class="field"><label for="k-name">Name</label><input id="k-name" name="name" required></div>
          <div class="field"><label for="k-firma">Firma</label><input id="k-firma" name="firma"></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="k-email">E-Mail</label><input id="k-email" type="email" name="email" required></div>
          <div class="field"><label for="k-tel">Telefon</label><input id="k-tel" type="tel" name="tel"></div>
        </div>
        <div class="field">
          <label for="k-betreff">Betreff</label>
          <select id="k-betreff" name="betreff">
            <option>Kaufanfrage</option>
            <option>Mietanfrage</option>
            <option>Ersatzteile</option>
            <option>Gebrauchtmaschinen</option>
            <option>Schulung</option>
            <option>Allgemeine Anfrage</option>
          </select>
        </div>
        <div class="field"><label for="k-nachricht">Nachricht</label><textarea id="k-nachricht" name="nachricht" placeholder="Bitte beschreiben Sie Ihr Anliegen, Projekt oder gesuchtes Bauteil." required></textarea></div>
        <label class="field-check"><input type="checkbox" required> Ich habe die <a href="/datenschutz.html" style="color: var(--brand); text-decoration: underline;">Datenschutzerklärung</a> zur Kenntnis genommen.</label>
        <button type="submit" class="btn btn-brand is-lg" style="justify-self: start;">Anfrage senden <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button>
        <p data-form-status role="status" hidden style="color: var(--brand); font-weight: 500;"></p>
      </form>
    </div>
  </div>
</section>
