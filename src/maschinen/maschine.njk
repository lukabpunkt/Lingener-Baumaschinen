---
pagination:
  addAllPagesToCollections: true
  data: maschinenseiten
  size: 1
  alias: maschine
permalink: "{{ '/en/maschinen/' + maschine.slug + '.html' if maschine.lang == 'en' else '/maschinen/' + maschine.slug + '.html' }}"
layout: base.njk
nav: "maschinen"
navSolid: true

eleventyComputed:
  lang: "{{ maschine.lang }}"
  langDE: "{{ maschine.langDE }}"
  langEN: "{{ maschine.langEN }}"
  title: "{% if maschine.lang == 'de' %}{{ maschine.name }} — {{ maschine.subtitleDE | safe }} | LIBA{% else %}{{ maschine.name }} — {{ maschine.subtitleEN | safe }} | LIBA{% endif %}"
  description: "{% if maschine.lang == 'de' %}{{ maschine.name }}: {{ maschine.subtitleDE | safe }}. Grabenfräsen Made in Germany — LIBA Lingener Baumaschinen.{% else %}{{ maschine.name }}: {{ maschine.subtitleEN | safe }}. Trench cutters Made in Germany — LIBA Lingener Baumaschinen.{% endif %}"
  canonical: "{% if maschine.lang == 'de' %}https://lingener-baumaschinen.de{{ maschine.langDE }}{% else %}https://lingener-baumaschinen.de{{ maschine.langEN }}{% endif %}"
  ogTitle: "{% if maschine.lang == 'de' %}{{ maschine.name }} — {{ maschine.subtitleDE | safe }} | LIBA{% else %}{{ maschine.name }} — {{ maschine.subtitleEN | safe }} | LIBA{% endif %}"
  ogDescription: "{% if maschine.lang == 'de' %}{{ maschine.subtitleDE | safe }}. LIBA Lingener Baumaschinen — Made in Germany seit 1969.{% else %}{{ maschine.subtitleEN | safe }}. LIBA Lingener Baumaschinen — Made in Germany since 1969.{% endif %}"
  ogLocale: "{{ 'de_DE' if maschine.lang == 'de' else 'en_GB' }}"
  ogImage: "{{ maschine.ogImage }}"
  schema: "{{ maschine.schema | safe }}"
---

<section class="page-hero">
  <div class="page-hero-bg" style="background-image: url('{{ maschine.heroImage }}');" aria-hidden="true"></div>
  <div class="container">
    <div class="breadcrumbs">
      <a href="{% if lang == 'de' %}/index.html{% else %}/en/index.html{% endif %}">{% if lang == "de" %}Start{% else %}Home{% endif %}</a>
      <span class="sep">/</span>
      <a href="{% if lang == 'de' %}/maschinen.html{% else %}/en/maschinen.html{% endif %}">{% if lang == "de" %}Maschinen{% else %}Machines{% endif %}</a>
      <span class="sep">/</span>
      <span>{{ maschine.name }}</span>
    </div>
    <span class="eyebrow hero-eyebrow">
      <span class="dot"></span>{{ maschine.categoryLabel }}{% if maschine.condition != 'Neu' %} · {{ maschine.conditionLabel }}{% if maschine.year %} {{ maschine.year }}{% endif %}{% endif %}
    </span>
    <h1 data-split-lines class="mt-3">{{ maschine.name }}</h1>
    <p>{% if lang == "de" %}{{ maschine.subtitleDE }}{% else %}{{ maschine.subtitleEN }}{% endif %}</p>
    <div class="hero-actions mt-4">
      <a href="{% if lang == 'de' %}/kontakt.html{% else %}/en/kontakt.html{% endif %}" class="btn btn-accent is-lg">{% if lang == "de" %}Angebot anfragen{% else %}Request a quote{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      <a href="#technik" class="btn btn-outline-light">{% if lang == "de" %}Technische Daten{% else %}Technical specifications{% endif %}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="split align-start reveal">
      <div class="media-frame is-wide">
        <picture><source type="image/webp" srcset="{{ maschine.heroImage | replace('.jpg', '.webp') | replace('.png', '.webp') }}"><img loading="lazy" src="{{ maschine.heroImage }}" alt="{% if lang == 'de' %}{{ maschine.heroAltDE }}{% else %}{{ maschine.heroAltEN }}{% endif %}"></picture>
        <span class="tag">{{ maschine.categoryLabel }}{% if maschine.condition != 'Neu' %} · {{ maschine.conditionLabel }}{% if maschine.year %} {{ maschine.year }}{% endif %}{% endif %}</span>
      </div>
      <div>
        <span class="section-index">{% if lang == "de" %}01 / Übersicht{% else %}01 / Overview{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}{{ maschine.subtitleDE }}<br><em class="serif-italic">{{ maschine.name }}.</em>{% else %}{{ maschine.subtitleEN }}<br><em class="serif-italic">{{ maschine.name }}.</em>{% endif %}</h2>
        <p class="lead mt-3">{{ maschine.intro }}</p>
        <a href="{% if lang == 'de' %}/assets/pdfs/LIBA-Broschuere.pdf{% else %}/assets/pdfs/LIBA-Brochure.pdf{% endif %}" class="btn-link mt-3" download>
          {% if lang == "de" %}Broschüre herunterladen{% else %}Download brochure{% endif %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 15V3m0 12l-4-4m4 4l4-4"/><path d="M2 17l.621 2.485A2 2 0 004.561 21h14.878a2 2 0 001.94-1.515L22 17"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="section section-dark" id="technik">
  <div class="container">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index is-dark" style="color: var(--brand-light);">{% if lang == "de" %}02 / Technische Daten{% else %}02 / Technical Specifications{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Spezifikationen<br><em class="serif-italic">{{ maschine.name }}.</em>{% else %}Specifications<br><em class="serif-italic">{{ maschine.name }}.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Richtwerte je nach Konfiguration. Wir konfigurieren jede Maschine individuell — schicken Sie uns Ihr Einsatzprofil.{% else %}Indicative figures depending on configuration. We configure every machine individually — please send us your application profile.{% endif %}</p>
      </div>
    </div>
    <div class="reveal">
      <table class="spec-table" style="max-width: 680px;">
        <tbody>
          {% for row in maschine.specs %}
          <tr>
            <th>{% if lang == "de" %}{{ row.de }}{% else %}{{ row.en }}{% endif %}</th>
            <td>{% if lang == "en" and row.valEN %}{{ row.valEN }}{% else %}{{ row.val }}{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0;" id="anwendungen-maschine">
  <div class="container">
    <hr class="divider">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index">{% if lang == "de" %}03 / Einsatzbereiche{% else %}03 / Applications{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Wo die {{ maschine.name }}<br><em class="serif-italic">arbeitet.</em>{% else %}Where the {{ maschine.name }}<br><em class="serif-italic">works.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}LIBA-Grabenfräsen sind für ein breites Spektrum an Einsätzen ausgelegt. Entdecken Sie die Anwendungsbereiche — und finden Sie heraus, wo diese Maschine ihre Stärken am besten entfaltet.{% else %}LIBA trench cutters are designed for a wide range of applications. Explore the fields where this machine delivers its full potential.{% endif %}</p>
        <a href="{% if lang == 'de' %}/anwendungen.html{% else %}/en/anwendungen.html{% endif %}" class="btn-link mt-4">{% if lang == "de" %}Alle Einsatzbereiche{% else %}All applications{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      </div>
    </div>
    <div class="grid grid-3 reveal">
      <a href="{% if lang == 'de' %}/anwendungen.html#glasfaser{% else %}/en/anwendungen.html#glasfaser{% endif %}" class="application-link-card">
        <strong>{% if lang == "de" %}Glasfaserausbau{% else %}Fibre Optic Rollout{% endif %}</strong>
        <span>{% if lang == "de" %}FTTH · FTTB · Backbone{% else %}FTTH · FTTB · Backbone{% endif %}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="{% if lang == 'de' %}/anwendungen.html#pipeline{% else %}/en/anwendungen.html#pipeline{% endif %}" class="application-link-card">
        <strong>{% if lang == "de" %}Pipeline & Rohrleitungsbau{% else %}Pipeline & Pipe Installation{% endif %}</strong>
        <span>{% if lang == "de" %}Gas · Wasser · Abwasser{% else %}Gas · Water · Sewage{% endif %}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="{% if lang == 'de' %}/anwendungen.html#kabel{% else %}/en/anwendungen.html#kabel{% endif %}" class="application-link-card">
        <strong>{% if lang == "de" %}Strom- & Solartrassen{% else %}Power & Solar Cable Routes{% endif %}</strong>
        <span>{% if lang == "de" %}PV · Wind · Mittelspannung{% else %}PV · Wind · Medium voltage{% endif %}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="{% if lang == 'de' %}/anwendungen.html#drainage{% else %}/en/anwendungen.html#drainage{% endif %}" class="application-link-card">
        <strong>{% if lang == "de" %}Sportplatzbau & Drainage{% else %}Sports Field & Drainage{% endif %}</strong>
        <span>{% if lang == "de" %}Rasen · Kunstrasen · Golf{% else %}Natural turf · Artificial turf · Golf{% endif %}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="{% if lang == 'de' %}/anwendungen.html#landwirtschaft{% else %}/en/anwendungen.html#landwirtschaft{% endif %}" class="application-link-card">
        <strong>{% if lang == "de" %}Landwirtschaft & Bewässerung{% else %}Agriculture & Irrigation{% endif %}</strong>
        <span>{% if lang == "de" %}Drainage · Bewässerung · Agrar{% else %}Drainage · Irrigation · Agriculture{% endif %}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="{% if lang == 'de' %}/anwendungen.html#tiefbau{% else %}/en/anwendungen.html#tiefbau{% endif %}" class="application-link-card">
        <strong>{% if lang == "de" %}Bergbau, Felsen & Gleisbau{% else %}Mining, Rock & Track{% endif %}</strong>
        <span>{% if lang == "de" %}Bergbau · Gleis · Fels{% else %}Mining · Track · Rock{% endif %}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<section class="section" id="faq" style="padding-top: 0;">
  <div class="container">
    <hr class="divider">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index">{% if lang == "de" %}04 / Häufige Fragen{% else %}04 / FAQ{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Fragen zur<br><em class="serif-italic">{{ maschine.name }}.</em>{% else %}Questions about the<br><em class="serif-italic">{{ maschine.name }}.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Die wichtigsten Fakten zur {{ maschine.name }} — direkt beantwortet.{% else %}The key facts about the {{ maschine.name }} — answered directly.{% endif %}</p>
      </div>
    </div>
    <div class="faq-list reveal">
      {% for f in maschine.faqs %}
      <details class="faq-item">
        <summary>{{ f.q }}<span class="faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span></summary>
        <p class="faq-answer">{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>

    {% if maschine.related.length %}
    <div class="reveal" style="margin-top: 3rem;">
      <span class="section-index">{% if lang == "de" %}Ähnliche Maschinen{% else %}Related machines{% endif %}</span>
      <div class="grid grid-3 mt-3">
        {% for r in maschine.related %}
        <a href="{% if lang == 'de' %}/maschinen/{{ r.slug }}.html{% else %}/en/maschinen/{{ r.slug }}.html{% endif %}" class="application-link-card">
          <strong>{{ r.name }}</strong>
          <span>{{ maschine.categoryLabel }} · {% if lang == "de" %}Grabenfräse{% else %}Trench cutter{% endif %}</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-block reveal">
      <div>
        <span class="eyebrow is-dark"><span class="dot"></span>{% if lang == "de" %}Konkrete Anfrage{% else %}Specific Enquiry{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Konfigurieren Sie<br>Ihre <em>{{ maschine.name }}.</em>{% else %}Configure your<br><em>{{ maschine.name }}.</em>{% endif %}</h2>
        <p>{% if lang == "de" %}Jede Maschine wird individuell auf Ihr Projekt abgestimmt. Sprechen Sie mit unserer Konstruktion über Trägergerät, Frästiefe und Werkzeugbestückung.{% else %}Every machine is individually configured for your project. Talk to our engineering team about carrier machine, cutting depth and tooling configuration.{% endif %}</p>
        <div class="actions">
          <a href="{% if lang == 'de' %}/kontakt.html{% else %}/en/kontakt.html{% endif %}" class="btn btn-accent is-lg">{% if lang == "de" %}Angebot anfragen{% else %}Request a quote{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href="{% if lang == 'de' %}/maschinen.html{% else %}/en/maschinen.html{% endif %}" class="btn btn-outline-light">{% if lang == "de" %}Alle Maschinen{% else %}All machines{% endif %}</a>
        </div>
      </div>
      <dl class="cta-side">
        <dt>{% if lang == "de" %}Vertrieb direkt vom Werk{% else %}Sales direct from the factory{% endif %}</dt>
        <dd>+49 (0) 591 76 314</dd>
        <dt>{% if lang == "de" %}E-Mail{% else %}Email{% endif %}</dt>
        <dd style="word-break: break-word;">info@lingener-baumaschinen.de</dd>
      </dl>
    </div>
  </div>
</section>
