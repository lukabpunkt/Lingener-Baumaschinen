---
pagination:
  addAllPagesToCollections: true
  data: site.langs
  size: 1
  alias: lang
permalink: "{{ '/en/faq.html' if lang == 'en' else '/faq.html' }}"
layout: base.njk
nav: ""
navSolid: true
langDE: "/faq.html"
langEN: "/en/faq.html"

titleDE: "Häufige Fragen zu Grabenfräsen — LIBA Lingener Baumaschinen"
titleEN: "Trench Cutter FAQ — LIBA Lingener Baumaschinen"
descDE: "Antworten rund um Grabenfräsen: Frästiefe, Kauf, Miete, Gebrauchtmaschinen, Anwendungen und Modellwahl. Direkt vom Hersteller LIBA aus Lingen (Ems) — Made in Germany seit 1969."
descEN: "Answers about trench cutters: cutting depth, purchase, hire, used machines, applications and model selection. Direct from manufacturer LIBA in Lingen (Ems) — Made in Germany since 1969."
canonicalDE: "https://www.lingener-baumaschinen.de/faq.html"
canonicalEN: "https://www.lingener-baumaschinen.de/en/faq.html"
ogTitleDE: "Häufige Fragen zu Grabenfräsen — LIBA"
ogTitleEN: "Trench Cutter FAQ — LIBA"

eleventyComputed:
  title: "{{ titleDE if lang == 'de' else titleEN }}"
  description: "{{ descDE if lang == 'de' else descEN }}"
  canonical: "{{ canonicalDE if lang == 'de' else canonicalEN }}"
  ogTitle: "{{ ogTitleDE if lang == 'de' else ogTitleEN }}"
  ogDescription: "{{ descDE if lang == 'de' else descEN }}"
  ogLocale: "{{ 'de_DE' if lang == 'de' else 'en_GB' }}"
  schema: "{{ (faq.schema.de if lang == 'de' else faq.schema.en) | safe }}"
---

<section class="page-hero">
  <div class="page-hero-bg" style="background-image: url('/assets/images/products/gm-180-af.jpg');" aria-hidden="true"></div>
  <div class="container">
    <div class="breadcrumbs"><a href="{% if lang == 'de' %}/index.html{% else %}/en/index.html{% endif %}">{% if lang == "de" %}Start{% else %}Home{% endif %}</a><span class="sep">/</span><span>{% if lang == "de" %}Häufige Fragen{% else %}FAQ{% endif %}</span></div>
    <span class="eyebrow hero-eyebrow"><span class="dot"></span>{% if lang == "de" %}Wissen{% else %}Knowledge{% endif %}</span>
    <h1 data-split-lines class="mt-3">{% if lang == "de" %}Häufige <em class="serif-italic">Fragen.</em>{% else %}Frequently Asked <em class="serif-italic">Questions.</em>{% endif %}</h1>
    <p>{% if lang == "de" %}Die wichtigsten Fragen rund um Grabenfräsen — Frästiefe, Kauf, Miete, Anwendungen und Modellwahl. Direkt vom Hersteller beantwortet.{% else %}The key questions about trench cutters — cutting depth, purchase, hire, applications and model selection. Answered directly by the manufacturer.{% endif %}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index">{% if lang == "de" %}01 / Grabenfräsen{% else %}01 / Trench Cutters{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Alles, was Sie<br><em class="serif-italic">wissen müssen.</em>{% else %}Everything you<br><em class="serif-italic">need to know.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Keine Antwort gefunden? Sprechen Sie direkt mit unserer Konstruktion in Lingen.{% else %}Didn't find your answer? Talk directly to our engineering team in Lingen.{% endif %}</p>
        <a href="{% if lang == 'de' %}/kontakt.html{% else %}/en/kontakt.html{% endif %}" class="btn btn-ghost">
          {% if lang == "de" %}Frage stellen{% else %}Ask a question{% endif %}
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <div class="faq-list reveal">
      {% for f in faq.items %}
      <details class="faq-item"{% if loop.first %} open{% endif %}>
        <summary>{% if lang == "de" %}{{ f.qde }}{% else %}{{ f.qen }}{% endif %}<span class="faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span></summary>
        <p class="faq-answer">{% if lang == "de" %}{{ f.ade }}{% else %}{{ f.aen }}{% endif %}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="cta-block reveal">
      <div>
        <span class="eyebrow is-dark"><span class="dot"></span>{% if lang == "de" %}Beratung anfordern{% else %}Request advice{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Welche Fräse passt<br>zu Ihrem <em>Projekt?</em>{% else %}Which cutter suits<br>your <em>project?</em>{% endif %}</h2>
        <p>{% if lang == "de" %}Schildern Sie uns Bodenart, Trägergerät und Grabentiefe — Sie erhalten innerhalb von 24 Stunden eine technische Einschätzung direkt vom LIBA-Werk in Lingen.{% else %}Tell us your soil type, carrier machine and trench depth — you'll receive a technical assessment directly from the LIBA factory in Lingen within 24 hours.{% endif %}</p>
        <div class="actions">
          <a href="{% if lang == 'de' %}/kontakt.html{% else %}/en/kontakt.html{% endif %}" class="btn btn-accent is-lg">{% if lang == "de" %}Kostenlose Beratung{% else %}Free consultation{% endif %} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href="{% if lang == 'de' %}/maschinen.html{% else %}/en/maschinen.html{% endif %}" class="btn btn-outline-light">{% if lang == "de" %}Alle Maschinen{% else %}All machines{% endif %}</a>
        </div>
      </div>
      <dl class="cta-side">
        <dt>{% if lang == "de" %}Telefon{% else %}Phone{% endif %}</dt>
        <dd>+49 (0) 591 76 314</dd>
        <dt>{% if lang == "de" %}E-Mail{% else %}Email{% endif %}</dt>
        <dd style="word-break: break-word;">info@lingener-baumaschinen.de</dd>
      </dl>
    </div>
  </div>
</section>
