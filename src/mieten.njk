<section class="page-hero">
  <div class="page-hero-bg" style="background-image: url('/assets/images/products/gm-4-raupe.jpg');" aria-hidden="true"></div>
  <div class="container">
    <div class="breadcrumbs"><a href="{% if lang == 'de' %}/index.html{% else %}/en/index.html{% endif %}">{% if lang == "de" %}Start{% else %}Home{% endif %}</a><span class="sep">/</span><span>{% if lang == "de" %}Mieten{% else %}Hire{% endif %}</span></div>
    <span class="eyebrow hero-eyebrow"><span class="dot"></span>{% if lang == "de" %}Flexibel statt fix{% else %}Flexible instead of fixed{% endif %}</span>
    <h1 data-split-lines class="mt-3">{% if lang == "de" %}Grabenfräse mieten —<br><em class="serif-italic">direkt vom Hersteller.</em>{% else %}Hire a trench cutter —<br><em class="serif-italic">direct from the manufacturer.</em>{% endif %}</h1>
    <p>{% if lang == "de" %}Effizienter Kabel- und Glasfaserbau ohne Kapitalbindung. Tages-, Wochen- und Monatsmiete für ausgewählte LIBA-Modelle, inklusive Einweisung und 24/7-Service.{% else %}Efficient cable and fibre optic installation without capital commitment. Daily, weekly and monthly hire for selected LIBA models, including operator training and 24/7 service.{% endif %}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index">{% if lang == "de" %}01 / Verfügbare Mietmaschinen{% else %}01 / Available Hire Machines{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Drei Selbstfahrer.<br><em class="serif-italic">Drei Einsatzprofile.</em>{% else %}Three self-propelled.<br><em class="serif-italic">Three application profiles.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Alle Mietmaschinen werden mit Bedienereinweisung übergeben und kommen aus dem Werk Lingen — inklusive 24/7-Werks­hotline während des Einsatzes.{% else %}All hire machines are handed over with operator training and come from the Lingen factory — including 24/7 factory hotline during deployment.{% endif %}</p>
      </div>
    </div>

    <div class="avail-notice reveal" style="display:inline-flex;align-items:center;gap:.5rem;padding:.45rem 1rem;font-size:.8rem;font-weight:600;margin-bottom:1.5rem;">
      <span style="width:8px;height:8px;border-radius:50%;background:#4ade80;flex-shrink:0;"></span>
      {% if lang == "de" %}Aktuell 3 Mietgeräte sofort verfügbar — Anfrage heute, Lieferung innerhalb 48h{% else %}Currently 3 hire machines immediately available — enquire today, delivery within 48 h{% endif %}
    </div>

    <div class="grid grid-3">
      <article class="news-card reveal">
        <div class="news-card-image"><picture><source type="image/webp" srcset="/assets/images/products/gm-4-raupe.webp"><img loading="lazy" src="/assets/images/products/gm-4-raupe.jpg" alt="" width="1024" height="768"></picture></div>
        <div class="news-card-body">
          <span class="avail-badge is-green" style="display:inline-block;padding:.25rem .7rem;border-radius:999px;font-size:.72rem;font-weight:700;margin-bottom:.5rem;">{% if lang == "de" %}Sofort verfügbar{% else %}Immediately available{% endif %}</span>
          <div class="news-card-meta">{% if lang == "de" %}Glasfaser &amp; Telekommunikation{% else %}Fibre Optic &amp; Telecommunications{% endif %}</div>
          <h3>{% if lang == "de" %}GM 4 Raupe{% else %}GM 4 Crawler{% endif %}</h3>
          <p>{% if lang == "de" %}Wendige Raupenmaschine für den Glasfaserausbau. Tagesleistung bis 800 m bei sauberem Vortrieb.{% else %}Manoeuvrable tracked machine for fibre optic rollout. Daily output up to 800 m with clean progress.{% endif %}</p>
          <a href="#mietanfrage" class="link mt-3">{% if lang == "de" %}Verfügbarkeit anfragen{% else %}Check availability{% endif %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>

      <article class="news-card reveal reveal-delay-1">
        <div class="news-card-image"><picture><source type="image/webp" srcset="/assets/images/products/gm-4-raupe-2.webp"><img loading="lazy" src="/assets/images/products/gm-4-raupe-2.jpg" alt="" width="1024" height="768"></picture></div>
        <div class="news-card-body">
          <span class="avail-badge is-green" style="display:inline-block;padding:.25rem .7rem;border-radius:999px;font-size:.72rem;font-weight:700;margin-bottom:.5rem;">{% if lang == "de" %}Sofort verfügbar{% else %}Immediately available{% endif %}</span>
          <div class="news-card-meta">{% if lang == "de" %}Sportplatz &amp; Drainage{% else %}Sports Fields &amp; Drainage{% endif %}</div>
          <h3>{% if lang == "de" %}GM 4 Allrad{% else %}GM 4 All-Wheel{% endif %}</h3>
          <p>{% if lang == "de" %}Allradangetriebener Selbstfahrer für Sportplatz­drainage und Solartrassen. Minimale Spuren.{% else %}All-wheel-drive self-propelled machine for sports field drainage and solar routes. Minimal ground damage.{% endif %}</p>
          <a href="#mietanfrage" class="link mt-3">{% if lang == "de" %}Verfügbarkeit anfragen{% else %}Check availability{% endif %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>

      <article class="news-card reveal reveal-delay-2">
        <div class="news-card-image"><picture><source type="image/webp" srcset="/assets/images/products/gm-6-asr.webp"><img loading="lazy" src="/assets/images/products/gm-6-asr.jpg" alt="" width="1024" height="768"></picture></div>
        <div class="news-card-body">
          <span class="avail-badge is-amber" style="display:inline-block;padding:.25rem .7rem;border-radius:999px;font-size:.72rem;font-weight:700;margin-bottom:.5rem;">{% if lang == "de" %}Ab nächster Woche{% else %}Available from next week{% endif %}</span>
          <div class="news-card-meta">{% if lang == "de" %}Felsen &amp; Bergbau{% else %}Rock &amp; Mining{% endif %}</div>
          <h3>GM 6 ASR</h3>
          <p>{% if lang == "de" %}Die Felsfräse für extrem harten Untergrund. Wo Bagger und Trennsäge scheitern, beginnt die GM 6 ASR.{% else %}The rock cutter for extremely hard ground. Where excavators and cut-off saws fail, the GM 6 ASR begins.{% endif %}</p>
          <a href="#mietanfrage" class="link mt-3">{% if lang == "de" %}Verfügbarkeit anfragen{% else %}Check availability{% endif %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        </div>
      </article>
    </div>

    <hr class="divider">

    <div class="split align-start reveal">
      <div>
        <span class="section-index">{% if lang == "de" %}02 / Vorteile{% else %}02 / Benefits{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Warum LIBA mieten?{% else %}Why hire from LIBA?{% endif %}</h2>
        <p class="lead mt-3">{% if lang == "de" %}Mehr als nur Maschine: Sie mieten Kompetenz aus dem LIBA-Werk Lingen — mit allen Vorteilen des direkten Werks­kontakts.{% else %}More than just a machine: you hire expertise from the LIBA factory in Lingen — with all the advantages of direct factory contact.{% endif %}</p>
      </div>
      <ul class="spec-list is-kerf">
        <li><strong>{% if lang == "de" %}Einweisung inklusive{% else %}Training included{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Bedienerschulung am Tag der Anlieferung — Praxis statt Handbuch.{% else %}Operator training on the day of delivery — practical, not just a manual.{% endif %}</span></li>
        <li><strong>{% if lang == "de" %}Werks-Hotline 24/7{% else %}Factory hotline 24/7{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Im Notfall direkt mit dem Konstrukteur sprechen.{% else %}In an emergency, speak directly with the design engineers.{% endif %}</span></li>
        <li><strong>{% if lang == "de" %}Flexible Mietdauer{% else %}Flexible hire periods{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Tag, Woche, Monat — auf Ihr Bauphasen-Timing.{% else %}Day, week, month — tailored to your construction schedule.{% endif %}</span></li>
        <li><strong>{% if lang == "de" %}Option zum Kauf{% else %}Option to purchase{% endif %}</strong><span class="spec-desc">{% if lang == "de" %}Bis zu 100 % der Mietzeit auf den Kauf anrechenbar.{% else %}Up to 100% of hire costs offset against the purchase price.{% endif %}</span></li>
      </ul>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0;" id="faq-miete">
  <div class="container">
    <hr class="divider">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index">{% if lang == "de" %}03 / Häufige Fragen{% else %}03 / Frequently Asked Questions{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Fragen zur<br><em class="serif-italic">Mietmaschine.</em>{% else %}Questions about<br><em class="serif-italic">hire machines.</em>{% endif %}</h2>
      </div>
    </div>
    <div class="faq-list reveal">

      <details class="faq-item">
        <summary>{% if lang == "de" %}Welche Grabenfräsen kann ich bei LIBA mieten?{% else %}Which trench cutters can I hire from LIBA?{% endif %}<span class="faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span></summary>
        <p class="faq-answer">{% if lang == "de" %}Bei LIBA können Sie folgende Grabenfräsen mieten: GM 4 Raupe (für Glasfaser und Telekommunikation), GM 4 Allrad (für Drainage und Solartrassen) und GM 6 ASR (für Fels und Hartgestein). Alle Mietgeräte werden direkt vom Werk Lingen geliefert.{% else %}From LIBA you can hire the following trench cutters: GM 4 Crawler (for fibre optic and telecommunications), GM 4 All-Wheel (for drainage and solar routes) and GM 6 ASR (for rock and hard ground). All hire machines are delivered directly from the Lingen factory.{% endif %}</p>
      </details>

      <details class="faq-item">
        <summary>{% if lang == "de" %}Wie schnell ist eine gemietete LIBA-Grabenfräse verfügbar?{% else %}How quickly is a hired LIBA trench cutter available?{% endif %}<span class="faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span></summary>
        <p class="faq-answer">{% if lang == "de" %}In der Regel sind die Mietgeräte von LIBA sofort verfügbar. Bei einer Anfrage heute ist die Lieferung innerhalb von 48 Stunden deutschlandweit möglich. Der Transport erfolgt per Tieflader auf Wunsch.{% else %}In most cases, LIBA hire machines are immediately available. With an enquiry today, delivery within 48 hours is possible across Germany. Transport by low-loader can be arranged on request.{% endif %}</p>
      </details>

      <details class="faq-item">
        <summary>{% if lang == "de" %}Ist eine Bedienereinweisung beim Mietgerät inbegriffen?{% else %}Is operator training included with the hire machine?{% endif %}<span class="faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span></summary>
        <p class="faq-answer">{% if lang == "de" %}Ja. Jede Mietmaschine von LIBA wird mit einer Bedienereinweisung am Tag der Anlieferung übergeben. Zusätzlich steht die LIBA-Werkshotline 24/7 für technische Fragen während des Einsatzes zur Verfügung.{% else %}Yes. Every LIBA hire machine is handed over with operator training on the day of delivery. In addition, the LIBA factory hotline is available 24/7 for technical questions during deployment.{% endif %}</p>
      </details>

      <details class="faq-item">
        <summary>{% if lang == "de" %}Kann ich eine gemietete Grabenfräse später kaufen?{% else %}Can I purchase a hired trench cutter afterwards?{% endif %}<span class="faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span></summary>
        <p class="faq-answer">{% if lang == "de" %}Ja. Bei LIBA besteht die Möglichkeit, eine Mietmaschine im Anschluss zu kaufen. Bis zu 100 % der geleisteten Mietzeit kann dabei auf den Kaufpreis angerechnet werden.{% else %}Yes. LIBA offers the option to purchase a hire machine at the end of the hire period. Up to 100% of the hire period already completed can be offset against the purchase price.{% endif %}</p>
      </details>

      <details class="faq-item">
        <summary>{% if lang == "de" %}Wie lange kann ich eine Grabenfräse bei LIBA mieten?{% else %}How long can I hire a trench cutter from LIBA?{% endif %}<span class="faq-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span></summary>
        <p class="faq-answer">{% if lang == "de" %}LIBA bietet flexible Mietzeiten an — tageweise, wochenweise oder monatlich. Die Mietdauer richtet sich nach Ihrem Bauvorhaben und wird individuell vereinbart.{% else %}LIBA offers flexible hire periods — by the day, week or month. The hire duration is tailored to your construction schedule and agreed individually.{% endif %}</p>
      </details>

    </div>
  </div>
</section>

<section class="roi-section section" id="roi-rechner">
  <div class="container">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index">{% if lang == "de" %}04 / Kaufen vs. Mieten{% else %}04 / Buy vs. Hire{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Was lohnt sich<br><em class="serif-italic">für Ihren Einsatz?</em>{% else %}What makes sense<br><em class="serif-italic">for your application?</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Geben Sie Ihre Einsatztage ein und sehen Sie sofort, ab wann der Kauf gegenüber der Miete wirtschaftlicher wird.{% else %}Enter your deployment days and see immediately when purchasing becomes more economical than hiring.{% endif %}</p>
      </div>
    </div>

    <div class="roi-inputs reveal">
      <div class="roi-field">
        <label for="roi-days">{% if lang == "de" %}Einsatztage pro Jahr{% else %}Deployment days per year{% endif %}</label>
        <input type="range" id="roi-days" min="5" max="180" value="60" class="roi-slider">
        <div class="roi-days-row">
          <span>{% if lang == "de" %}5 Tage{% else %}5 days{% endif %}</span>
          <strong id="roi-days-val">{% if lang == "de" %}60 Tage / Jahr{% else %}60 days / year{% endif %}</strong>
          <span>{% if lang == "de" %}180 Tage{% else %}180 days{% endif %}</span>
        </div>
      </div>
      <div class="roi-field">
        <label for="roi-machine">{% if lang == "de" %}Maschinentyp{% else %}Machine type{% endif %}</label>
        <select id="roi-machine" class="roi-select">
          <option value="95000,400">{% if lang == "de" %}GM 4 Raupe — Glasfaser &amp; Telekommunikation{% else %}GM 4 Crawler — Fibre Optic &amp; Telecommunications{% endif %}</option>
          <option value="90000,380">{% if lang == "de" %}GM 4 Allrad — Drainage &amp; Solarpark{% else %}GM 4 All-Wheel — Drainage &amp; Solar Park{% endif %}</option>
          <option value="135000,520">{% if lang == "de" %}GM 6 ASR — Fels &amp; Hartgestein{% else %}GM 6 ASR — Rock &amp; Hard Ground{% endif %}</option>
        </select>
      </div>
    </div>

    <div class="roi-comparison reveal" id="roi-comparison">
      <div class="roi-col">
        <div class="roi-col-label">{% if lang == "de" %}Jährliche Mietkosten{% else %}Annual hire costs{% endif %}</div>
        <div class="roi-amount" id="roi-rent-amount">—</div>
        <div class="roi-col-sub" id="roi-rent-sub">{% if lang == "de" %}60 Tage × 400 €/Tag{% else %}60 days × €400/day{% endif %}</div>
      </div>
      <div class="roi-vs">VS</div>
      <div class="roi-col">
        <div class="roi-col-label">{% if lang == "de" %}Jährliche Eigentumskosten*{% else %}Annual ownership costs*{% endif %}</div>
        <div class="roi-amount" id="roi-own-amount">—</div>
        <div class="roi-col-sub">{% if lang == "de" %}Abschr. + Wartung / Jahr{% else %}Depreciation + maintenance / year{% endif %}</div>
      </div>
    </div>

    <div class="roi-verdict" id="roi-verdict" data-contact-url="{{ ('/en/kontakt.html' if lang == 'en' else '/kontakt.html') | url }}"></div>

    <p class="roi-disclaimer">{% if lang == "de" %}* Richtwert: Kaufpreis / 15 Jahre + ca. 4.000 €/Jahr Wartungskosten. Unverbindliche Schätzung ohne Gewähr.{% else %}* Indicative figure: purchase price / 15 years + approx. €4,000/year maintenance costs. Non-binding estimate, no guarantee.{% endif %}</p>
  </div>
</section>

<section class="section section-dark" id="mietanfrage">
  <div class="container">
    <div class="reveal" style="max-width: 640px; margin: 0 auto; text-align: center;">
      <span class="section-index is-dark" style="color: var(--brand-light); justify-content: center;">{% if lang == "de" %}05 / Mietanfrage{% else %}05 / Hire Enquiry{% endif %}</span>
      <h2 class="mt-3">{% if lang == "de" %}Jetzt Verfügbarkeit<br><em class="serif-italic">anfragen.</em>{% else %}Check availability<br><em class="serif-italic">now.</em>{% endif %}</h2>
      <p class="lead mt-3">{% if lang == "de" %}Wir prüfen Verfügbarkeit, Logistik und Einsatzbedingungen — und melden uns innerhalb von 24 Stunden mit einem unverbindlichen Mietangebot.{% else %}We check availability, logistics and operating conditions — and get back to you within 24 hours with a no-obligation hire offer.{% endif %}</p>
      <div class="mt-5" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="{% if lang == 'en' %}/en/kontakt.html{% else %}/kontakt.html{% endif %}" class="btn btn-brand is-lg">
          {% if lang == "de" %}Zur Kontaktseite{% else %}Go to contact page{% endif %}
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="tel:+4959176314" class="btn btn-ghost is-lg">
          +49 (0) 591 76 314
        </a>
      </div>
    </div>
  </div>
</section>
