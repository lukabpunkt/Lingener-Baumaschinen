          <a href="{% if lang == 'de' %}/mieten.html{% else %}/en/mieten.html{% endif %}" class="btn btn-outline-light">{% if lang == "de" %}Mieten statt kaufen{% else %}Hire instead of buy{% endif %}</a>
        </div>
      </div>
      <dl class="cta-side">
        <dt>{% if lang == "de" %}Vertrieb direkt vom Werk{% else %}Sales direct from the factory{% endif %}</dt>
        <dd>+49 (0) 591 76 314</dd>
        <dt>{% if lang == "de" %}E-Mail{% else %}Email{% endif %}</dt>
        <dd style="word-break: break-word;">info@lingener-baumaschinen.de</dd>
      </dl>
    </div>
  </div>
</section>
