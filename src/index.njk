<!-- ==========  FERTIGUNGSPROZESS  ========== -->
<section class="section section-dark" style="padding-top: 0;">
  <div class="container">
    <div class="section-header reveal">
      <div class="heading">
        <span class="section-index is-dark" style="color: var(--brand-light);">{% if lang == "de" %}04 / Fertigung{% else %}04 / Manufacturing{% endif %}</span>
        <h2 class="mt-3">{% if lang == "de" %}Vier Schritte.<br><em class="serif-italic">Eine LIBA-Maschine.</em>{% else %}Four steps.<br><em class="serif-italic">One LIBA machine.</em>{% endif %}</h2>
      </div>
      <div class="aside">
        <p class="lead">{% if lang == "de" %}Vom Konstruktionsplan bis zur Auslieferung — jede Maschine entsteht in unserer eigenen Manufaktur in Lingen (Ems). Nichts wird zugekauft, was wir besser selbst machen können.{% else %}From design drawing to delivery — every machine is built in our own factory in Lingen (Ems). Nothing is bought in that we can make better ourselves.{% endif %}</p>
      </div>
    </div>
    <div class="process reveal">
      <div class="process-step">
        <div class="step-num">{% if lang == "de" %}Schritt 01{% else %}Step 01{% endif %}</div>
        <h4>{% if lang == "de" %}Konstruktion{% else %}Design{% endif %}</h4>
        <p>{% if lang == "de" %}Jede Maschine wird gemeinsam mit dem Kunden auf Bodenart, Trägergerät und Einsatzprofil hin spezifiziert.{% else %}Every machine is specified together with the customer for ground type, carrier machine and application profile.{% endif %}</p>
      </div>
      <div class="process-step">
        <div class="step-num">{% if lang == "de" %}Schritt 02{% else %}Step 02{% endif %}</div>
        <h4>{% if lang == "de" %}Schweißbau{% else %}Welding{% endif %}</h4>
        <p>{% if lang == "de" %}Hochfeste Stahlrahmen und Tragstrukturen — eigene Schweißerei mit erfahrenen Konstruktions­meistern.{% else %}High-tensile steel frames and load structures — our own welding shop with experienced master craftsmen.{% endif %}</p>
      </div>
      <div class="process-step">
        <div class="step-num">{% if lang == "de" %}Schritt 03{% else %}Step 03{% endif %}</div>
        <h4>{% if lang == "de" %}Hydraulik &amp; Mechanik{% else %}Hydraulics &amp; Mechanics{% endif %}</h4>
        <p>{% if lang == "de" %}Integration von Antrieb, Steuerung, Bestückung. Original­komponenten von Markenherstellern.{% else %}Integration of drive, controls and tooling. Original components from branded manufacturers.{% endif %}</p>
      </div>
      <div class="process-step">
        <div class="step-num">{% if lang == "de" %}Schritt 04{% else %}Step 04{% endif %}</div>
        <h4>{% if lang == "de" %}Abnahme &amp; Auslieferung{% else %}Testing &amp; Delivery{% endif %}</h4>
        <p>{% if lang == "de" %}Funktionsprüfung im Werk, persönliche Übergabe und Bediener­einweisung beim Kunden vor Ort.{% else %}Function testing at the factory, personal handover and operator training at the customer's site.{% endif %}</p>
      </div>
    </div>
  </div>
</section>

